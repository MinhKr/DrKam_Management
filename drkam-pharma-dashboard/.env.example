# ──────────────────────────────────────────────────────────────
# Supabase — lấy tại: Supabase Dashboard > Project Settings > API
# ──────────────────────────────────────────────────────────────
# URL dự án Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"

# Khóa công khai (anon) — an toàn để lộ ở phía client
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Khóa service role — CHỈ dùng phía server, TUYỆT ĐỐI không lộ ra client
# (dùng cho seed dữ liệu / tác vụ quản trị)
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# ──────────────────────────────────────────────────────────────
# TikTok Shop Open Platform (nối API doanh thu TikTok — giai đoạn sau)
# ──────────────────────────────────────────────────────────────
# TIKTOK_SHOP_APP_KEY=""
# TIKTOK_SHOP_APP_SECRET=""
